#!/usr/bin/env bash
set -euo pipefail

APP_ROOT="${APPDIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
ASSET_DIR="$APP_ROOT/usr/share/wolfenstein2026/assets"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
STATE_DIR="$DATA_HOME/wolfenstein2026"

mkdir -p "$STATE_DIR/saves"
ln -sfn "$ASSET_DIR" "$STATE_DIR/assets"
cd "$STATE_DIR"
exec "$APP_ROOT/usr/bin/wolf" "$@"
