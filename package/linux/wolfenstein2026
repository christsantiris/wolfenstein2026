#!/usr/bin/env bash
set -euo pipefail

APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
STATE_DIR="$DATA_HOME/wolfenstein2026/state"

mkdir -p "$STATE_DIR/saves"
ln -sfn "$APP_DIR/assets" "$STATE_DIR/assets"
cd "$STATE_DIR"
exec "$APP_DIR/wolf" "$@"
